# =============================================================================
# ORBIT ACADEMY — LAURA AI Companion Environment Configuration
# =============================================================================
# This file provides environment variables for the lightweight Express backend
# that securely proxies requests to Google Gemini Developer API.
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your real `.env` file containing your secret API key!
# - Your API key must NEVER be exposed to frontend browser code.
# - Do NOT prefix the key with `VITE_`.
#
# Instructions:
# 1. Copy this file to `.env` in the project root:
#    cp .env.example .env (or copy on Windows)
# 2. Get a free Gemini API key from Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 3. Paste your API key below into GEMINI_API_KEY.
# 4. Start the backend with: npm run server
# =============================================================================

# Server Port (default: 3001, proxied by Vite at /api)
PORT=3001

# Google Gemini API Key (FREE TIER from Google AI Studio)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model
# Recommended free-tier options:
# - gemini-2.5-flash (fastest, highly capable multimodal & text reasoning)
# - gemini-2.0-flash (fast, lightweight free-tier model)
GEMINI_MODEL=gemini-2.5-flash

